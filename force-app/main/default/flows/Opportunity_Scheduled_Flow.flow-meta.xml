<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Account_To_Collection</name>
        <label>Add_Account_To_Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>account.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCurrentAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>account.HighActivity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colAccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>account</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Reset_For_New_Account</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Last_Account</name>
        <label>Add_Last_Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>account.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCurrentAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>account.HighActivity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colAccountsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>account</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Opp_Count</name>
        <label>Increment_Opp_Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOppCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>incrementOpp</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_On_Oppo</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_For_New_Account</name>
        <label>Reset_For_New_Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loop_On_Oppo.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop_On_Oppo</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Final_Account_Check</name>
        <label>Final_Account_Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Var_Count_Greater_than_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOppCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Last_Account</targetReference>
            </connector>
            <label>Var Count Greater than 3</label>
        </rules>
    </decisions>
    <decisions>
        <name>Prev_Account_High_Activity</name>
        <label>Prev_Account_High_Activity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Reset_For_New_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Prev_Account_High_Activitys</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOppCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Account_To_Collection</targetReference>
            </connector>
            <label>Prev_Account_High_Activity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Same_Account</name>
        <label>Same Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Prev_Account_High_Activity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Same_Accounts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loop_On_Oppo.AccountId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varAccountCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Opp_Count</targetReference>
            </connector>
            <label>Same Account?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>incrementOpp</name>
        <dataType>Number</dataType>
        <expression>{!varOppCount} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>today</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <formulas>
        <name>todayPluseFiteenDays</name>
        <dataType>Date</dataType>
        <expression>Today()+15</expression>
    </formulas>
    <interviewLabel>Opportunity Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Scheduled Flow</label>
    <loops>
        <name>loop_On_Oppo</name>
        <label>loop On Oppo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Opportunity</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Same_Account</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Final_Account_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Opportunity</name>
        <label>Get All Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loop_On_Oppo</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CloseDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>today</elementReference>
            </value>
        </filters>
        <filters>
            <field>CloseDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>todayPluseFiteenDays</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>colAccountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Opportunity</targetReference>
        </connector>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2026-01-01</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
