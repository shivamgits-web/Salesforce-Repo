<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opp_Stage_Negotiation</fullName>
    <active>true</active>
    <errorConditionFormula>AND (Amount &lt; 10000,Amount&gt;100000, ISPICKVAL(StageName,&apos;Negotiation/Review&apos;))</errorConditionFormula>
